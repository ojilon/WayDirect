<?xml version="1.0" encoding="utf-8"?>
<!--
  Dark theme tokens (default in values/) â€” updated Oct 2025.

  Changes from previous glass-heavy palette:
    * Surfaces are solid/elevated instead of 60-80% translucent. The glass
      effect remains only for the bottom navigation scrim and the optional blur
      panels (when user enables glass blur in settings). This makes the UI
      crisper and prevents washed-out text on colorful wallpapers.
    * Outline colors softened; dividers use outline_variant at 12% opacity.
    * Category accents unchanged (users associate them with file types).
    * Added semantic colors: surface_container, outline_variant, divider.

  Light theme (values-night/colors.xml) mirrors the same structure with
  lighter values â€” both files now share identical token names.
-->
<resources>

    <!-- Core surfaces â€” solid defaults; elevation adds contrast via theme -->
    <color name="waydirect_background">#0A0C10</color>
    <color name="waydirect_surface">#151A22</color>
    <color name="waydirect_surface_solid">#151A22</color>
    <color name="waydirect_surface_variant">#1E2430</color>
    <color name="waydirect_surface_elevated">#1E2430</color>
    <color name="waydirect_surface_container">#1A1F2B</color>
    <!-- Glass remains for optional blur mode only (not default card background) -->
    <color name="waydirect_glass">#A3151A22</color>
    <color name="waydirect_glass_highlight">#1AFFFFFF</color>

    <!-- Brand -->
    <color name="waydirect_primary">#8BA4FF</color>
    <color name="waydirect_primary_dark">#6B86E8</color>
    <color name="waydirect_primary_container">#1E2A4A</color>
    <color name="waydirect_on_primary">#FFFFFF</color>

    <!-- Text -->
    <color name="waydirect_text_primary">#F2F4F8</color>
    <color name="waydirect_text_secondary">#9AA3B5</color>
    <color name="waydirect_text_disabled">#5C6575</color>
    <color name="waydirect_text_hint">#6B7588</color>

    <!-- Status -->
    <color name="waydirect_success">#3DCF8E</color>
    <color name="waydirect_warning">#F0B429</color>
    <color name="waydirect_error">#F07178</color>
    <color name="waydirect_info">#5CCFE6</color>

    <!-- Borders / dividers â€” softer, used sparingly (see FRONTEND docs) -->
    <color name="waydirect_outline">#3A4254</color>
    <color name="waydirect_outline_variant">#2A3040</color>
    <color name="waydirect_outline_glass">#1EA0A8B8</color>
    <!-- Corrected 6% white divider (Hex approximation for 6% opacity is 0F) -->
    <color name="waydirect_divider">#0FFFFFFF</color>
    <color name="waydirect_scrim">#660A0C10</color>      <!-- bottom nav scrim -->

    <!-- Category accents -->
    <color name="waydirect_cat_images">#FF8A65</color>
