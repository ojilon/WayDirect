<?xml version="1.0" encoding="utf-8"?>
<!--
  WayDirect dimension tokens.

  Change spacing/radius HERE to restyle the whole app.
  Prefer smaller radii (4–12dp) over large pills; min touch 48dp.
-->
<resources>

    <!-- Spacing scale -->
    <dimen name="spacing_xs">4dp</dimen>
    <dimen name="spacing_sm">8dp</dimen>
    <dimen name="spacing_md">16dp</dimen>
    <dimen name="spacing_lg">20dp</dimen>
    <dimen name="spacing_xl">28dp</dimen>

    <!-- Corner radii — keep modest -->
    <dimen name="radius_xs">4dp</dimen>   <!-- chips, list rows -->
    <dimen name="radius_sm">8dp</dimen>   <!-- cards, buttons -->
    <dimen name="radius_md">10dp</dimen>  <!-- hero cards -->
    <dimen name="radius_lg">12dp</dimen>  <!-- sheets -->
    <dimen name="radius_xl">16dp</dimen>  <!-- rare large surfaces -->

    <!-- Component sizing -->
    <dimen name="toolbar_height">56dp</dimen>
    <dimen name="bottom_nav_height">72dp</dimen>
    <dimen name="fab_size">56dp</dimen>
    <dimen name="list_item_height">56dp</dimen>
    <dimen name="button_min_height">48dp</dimen>
    <dimen name="divider_thickness">1dp</dimen>

</resources>
