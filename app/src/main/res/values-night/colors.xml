    <!-- Category accents â€” slightly deeper for light bg -->
    <color name="waydirect_cat_images">#E85D3C</color>
    <color name="waydirect_cat_videos">#1E88E5</color>
    <color name="waydirect_cat_audio">#8E24AA</color>
    <color name="waydirect_cat_docs">#43A047</color>
    <color name="waydirect_cat_others">#607D8B</color>
    <color name="waydirect_cat_sys">#FF8F00</color>

</resources>

