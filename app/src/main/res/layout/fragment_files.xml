<?xml version="1.0" encoding="utf-8"?>

<!--
  fragment_files.xml — Files tab shell.

  Owned by: FilesFragment (FragmentFilesBinding).
  List rows: FileAdapter + item_file.xml inside @id/file_list.

  Important ids (Java listeners / text):
    drawer_layout, btn_open_drawer, left_drawer  → navigation drawer
    search_input / search_layout                 → live search (IME actionSearch)
    current_path, btn_files_up                   → path bar + parent folder
    search_results_header                        → shown only while search results
    file_list                                    → RecyclerView of FileItems
    fab_new_folder                               → create folder shortcut
    empty_state                                  → visible when list is empty

  Runtime: FilesFragment.loadDirectory → native list JSON → FileItem list → adapter.
  Open file → FileOpenHelper; mutations → FileMutator.
  See docs/APP_MAP.md and docs/XML_UI_GUIDE.md.
-->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/waydirect_background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_sm"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btn_open_drawer"
                android:layout_width="@dimen/button_min_height"
                android:layout_height="@dimen/button_min_height"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_action_more"
                android:contentDescription="@string/btn_open_drawer_desc"
                app:tint="@color/waydirect_text_primary" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/search_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_sm"
                android:hint="@string/search_layout_hint"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                app:boxBackgroundColor="@color/waydirect_surface_variant"
                app:boxStrokeColor="@color/waydirect_outline_variant"
                app:hintTextColor="@color/waydirect_text_secondary"
                app:startIconDrawable="@drawable/ic_action_search">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/search_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:inputType="text"
                    android:imeOptions="actionSearch"
                    android:textColor="@color/waydirect_text_primary"
                    android:textColorHint="@color/waydirect_text_secondary" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_sm"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/current_path"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/waydirect_text_secondary"
                android:textSize="12sp"
                android:maxLines="2"
                android:ellipsize="start" />

            <ImageButton
                android:id="@+id/btn_files_up"
                android:layout_width="@dimen/button_min_height"
                android:layout_height="@dimen/button_min_height"
                android:layout_marginStart="@dimen/spacing_sm"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_action_up"
                android:contentDescription="Up"
                app:tint="@color/waydirect_text_primary" />
        </LinearLayout>

        <TextView
            android:id="@+id/search_results_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_xs"
            android:textColor="@color/waydirect_primary"
            android:textSize="13sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/file_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/spacing_md" />

        <!-- FAB for quick folder creation — standard Material pattern -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/spacing_md">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_new_folder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:contentDescription="Create new folder"
                android:src="@drawable/ic_folder"
                android:tint="@color/waydirect_on_primary"
                app:tint="@color/waydirect_on_primary"
                app:fabCustomSize="56dp" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/empty_state"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:padding="@dimen/spacing_xl">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/layout_fragment_files_text_5"
                android:textColor="@color/waydirect_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/layout_fragment_files_text_6"
                android:textColor="@color/waydirect_text_secondary"
                android:textSize="14sp"
                android:gravity="center" />
        </LinearLayout>

    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/left_drawer"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/bg_glass_sidebar"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/nav_menu"
        app:itemTextColor="@color/waydirect_text_primary"
        app:itemIconTint="@color/waydirect_primary" />

</androidx.drawerlayout.widget.DrawerLayout>
